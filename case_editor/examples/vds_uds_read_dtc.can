/*@!Encoding:65001*/
/*
 * VDS 节点 UDS 诊断 CAPL
 *
 * 按 DBC 中 VDS 诊断 ID 对发送 19 02 09，完整解析 UDS 正/负响应（不只识别 59 02 09 头）。
 *
 * Tx (VDS 发)  -> Rx (VDS 收)     DBC 信号（单信号承载 8 字节诊断数据）
 * 0x712 ADC    -> 0x71A           ADC_Diag_712_S / ADC_Diag_71A_S
 * 0x760 LFCR   -> 0x768           MRR_Diag_0x760_S / MRR_Diag_0x768_S
 * 0x736 Lidar  -> 0x73E           Lidar_Diag_0x736_S / Lidar_Diag_0x73E_S
 * 0x757 Lidar  -> 0x75F           Lidar_Diag_0x757_S / Lidar_Diag_0x75F_S
 * 0x784 Lidar  -> 0x78C           Lidar_Diag_0x784_S / MRR_Diag_0x78C_S
 * 0x7D4 LRCR   -> 0x7DC           MRR_Diag_0x7D4_S / MRR_Diag_0x7DC_S
 * 0x7F2 MRR    -> 0x7FA           MRR_Diag_0x7F2_S / MRR_Diag_0x7FA_S
 * 0x701 PAS    -> 0x709           PAS_Diag_0x701_S / PAS_Diag_0x709_S
 * 0x761 RFCR   -> 0x769           MRR_Diag_0x761_S / MRR_Diag_0x769_S
 * 0x7C2 RRCR   -> 0x7CA           MRR_Diag_0x7C2_S / MRR_Diag_0x7CA_S
 * 0x7DF Func   -> 各物理响应 ID   ADC_Diag_0x7DF_S
 *
 * 系统变量：
 *   diagnosticButton  int  1=触发
 *   diagnosticTarget  int  0~9 单 ECU，10=0x7DF，255=轮询全部物理 ECU
 *
 * 节点内变量 diagLastRxId / diagLastDtcCount 保存最近一次解析结果（无需额外 sysvar）。
 *
 * 默认 CAN 通道 DIAG_CAN_CH=2，按工程修改。
 */

variables
{
  const long DIAG_CAN_CH = 2;
  const byte DTC_STATUS_MASK = 0x09;
  const long DIAG_ECU_COUNT = 10;
  const long DIAG_FUNC_TARGET = 10;
  const long DIAG_ALL_TARGET = 255;
  const long UDS_BUF_SIZE = 1024;

  message 0x712 msg_ADC_0x712;
  message 0x760 msg_LFCR_0x760;
  message 0x736 msg_Lidar_0x736;
  message 0x757 msg_Lidar_0x757;
  message 0x784 msg_Lidar_0x784;
  message 0x7D4 msg_LRCR_0x7D4;
  message 0x7F2 msg_MRR_0x7F2;
  message 0x701 msg_PAS_0x701;
  message 0x761 msg_RFCR_0x761;
  message 0x7C2 msg_RRCR_0x7C2;
  message 0x7DF msg_VDS_0x7DF;

  msTimer tmr_diag_poll;
  long    diagPollIdx;
  long    diagPollActive;

  byte    udsRxBuf[10][1024];
  long    udsRxLen[10];
  long    udsRxIdx[10];
  byte    tpExpectSeq[10];
  long    tpRxActive[10];

  long    diagLastRxId;
  long    diagLastDtcCount;

  byte    diagRxData[8];
}

void Diag_ResetTpRx(long ecuIdx)
{
  if (ecuIdx < 0 || ecuIdx >= DIAG_ECU_COUNT)
    return;
  udsRxLen[ecuIdx] = 0;
  udsRxIdx[ecuIdx] = 0;
  tpExpectSeq[ecuIdx] = 1;
  tpRxActive[ecuIdx] = 0;
}

void Diag_ResetAllTpRx(void)
{
  long i;
  for (i = 0; i < DIAG_ECU_COUNT; i++)
    Diag_ResetTpRx(i);
}

long Diag_RxIdToEcuIdx(long rxId)
{
  switch (rxId)
  {
    case 0x71A: return 0;
    case 0x768: return 1;
    case 0x73E: return 2;
    case 0x75F: return 3;
    case 0x78C: return 4;
    case 0x7DC: return 5;
    case 0x7FA: return 6;
    case 0x709: return 7;
    case 0x769: return 8;
    case 0x7CA: return 9;
    default: return -1;
  }
}

void Diag_WriteEcuLabel(long ecuIdx)
{
  switch (ecuIdx)
  {
    case 0: write("ADC"); break;
    case 1: write("LFCR"); break;
    case 2: write("Lidar_736"); break;
    case 3: write("Lidar_757"); break;
    case 4: write("Lidar_784"); break;
    case 5: write("LRCR"); break;
    case 6: write("MRR"); break;
    case 7: write("PAS"); break;
    case 8: write("RFCR"); break;
    case 9: write("RRCR"); break;
    default: write("?"); break;
  }
}

void Diag_FormatDtcCode(byte b0, byte b1, byte b2, char out[], long outSize)
{
  char prefix;
  long val;
  val = ((b0 & 0xFF) << 16) | ((b1 & 0xFF) << 8) | (b2 & 0xFF);
  switch ((b0 >> 6) & 0x03)
  {
    case 0: prefix = 'P'; break;
    case 1: prefix = 'C'; break;
    case 2: prefix = 'B'; break;
    default: prefix = 'U'; break;
  }
  snprintf(out, outSize, "%c%06X", prefix, val & 0x3FFFFF);
}

void Diag_DescribeStatus(byte st, char out[], long outSize)
{
  snprintf(
    out, outSize,
    "TF=%d Conf=%d Pend=%d MIL=%d raw=0x%02X",
    (st & 0x01) != 0,
    (st & 0x08) != 0,
    (st & 0x04) != 0,
    (st & 0x40) != 0,
    st
  );
}

void Diag_DescribeNrc(byte nrc, char out[], long outSize)
{
  switch (nrc)
  {
    case 0x12: snprintf(out, outSize, "子功能不支持"); break;
    case 0x13: snprintf(out, outSize, "报文长度或格式错误"); break;
    case 0x22: snprintf(out, outSize, "条件不满足"); break;
    case 0x31: snprintf(out, outSize, "请求超出范围"); break;
    case 0x33: snprintf(out, outSize, "安全访问拒绝"); break;
    case 0x78: snprintf(out, outSize, "响应挂起"); break;
    default:   snprintf(out, outSize, "否定响应码"); break;
  }
}

/* 将 DTC 状态字节翻译为中文短语（仅列出置位的含义） */
void Diag_WriteDtcStatusCn(byte st)
{
  long any;
  any = 0;
  write("      状态中文:");
  if ((st & 0x01) != 0) { write(" 当前测试失败"); any = 1; }
  if ((st & 0x02) != 0) { write(" 本周期测试失败"); any = 1; }
  if ((st & 0x04) != 0) { write(" 待确认"); any = 1; }
  if ((st & 0x08) != 0) { write(" 已确认"); any = 1; }
  if ((st & 0x10) != 0) { write(" 自清除后测试未完成"); any = 1; }
  if ((st & 0x20) != 0) { write(" 自清除后仍测试失败"); any = 1; }
  if ((st & 0x40) != 0) { write(" 故障灯(MIL)请求点亮"); any = 1; }
  if ((st & 0x80) != 0) { write(" 位7=1"); any = 1; }
  if (any == 0)
    write(" 无激活状态(正常/已恢复)");
}

void Diag_WriteMaskFilterCn(byte mask)
{
  long any;
  any = 0;
  write("      筛选条件:");
  if ((mask & 0x01) != 0) { write(" [测试失败]"); any = 1; }
  if ((mask & 0x02) != 0) { write(" [本周期测试失败]"); any = 1; }
  if ((mask & 0x04) != 0) { write(" [待确认]"); any = 1; }
  if ((mask & 0x08) != 0) { write(" [已确认]"); any = 1; }
  if ((mask & 0x10) != 0) { write(" [自清除后未完成]"); any = 1; }
  if ((mask & 0x20) != 0) { write(" [自清除后失败]"); any = 1; }
  if ((mask & 0x40) != 0) { write(" [MIL相关]"); any = 1; }
  if (any == 0)
    write(" 无筛选位");
}

void Diag_FormatDtcDomainCn(byte b0, char out[], long outSize)
{
  switch ((b0 >> 6) & 0x03)
  {
    case 0: snprintf(out, outSize, "动力系统"); break;
    case 1: snprintf(out, outSize, "底盘系统"); break;
    case 2: snprintf(out, outSize, "车身系统"); break;
    default: snprintf(out, outSize, "网络通信"); break;
  }
}

/*
 * 将如 59 02 09 FF 04 11 00 09 ... 的十六进制载荷逐段翻译成中文说明
 */
void Diag_PrintReadDtcChineseExplain(long ecuIdx)
{
  long off;
  long payloadLen;
  long recordSize;
  long idx;
  byte dtcB0, dtcB1, dtcB2, failType, status;
  char dtcStr[16];
  char domainCn[24];

  write("  --- 十六进制载荷中文释义 ---");
  write("  整段数据按 UDS 读DTC(19 02) 正响应格式解读，示例如:");
  write("  59 02 09 FF | 04 11 00 09 | 13 02 00 08");

  if (udsRxLen[ecuIdx] < 1)
  {
    write("  (无数据)");
    write("  --- 中文释义结束 ---");
    return;
  }

  if (udsRxBuf[ecuIdx][0] == 0x59)
    write("  [59] 读DTC信息服务正响应(请求服务0x19 的回显+0x40，表示读取成功)");
  else
    write("  [%02X] 服务标识字节", udsRxBuf[ecuIdx][0]);

  if (udsRxLen[ecuIdx] >= 2)
  {
    if (udsRxBuf[ecuIdx][1] == 0x02)
      write("  [02] 子功能: 按DTC状态掩码上报故障码列表");
    else
      write("  [%02X] 子功能/报告类型字节", udsRxBuf[ecuIdx][1]);
  }

  if (udsRxLen[ecuIdx] >= 3)
  {
    write("  [%02X] 状态掩码回显(与请求中掩码一致，表示按哪些状态筛选DTC)", udsRxBuf[ecuIdx][2]);
    Diag_WriteMaskFilterCn(udsRxBuf[ecuIdx][2]);
  }

  if (udsRxLen[ecuIdx] >= 4)
  {
    write("  [%02X] DTC状态可用性掩码(ECU能报告哪些状态位)", udsRxBuf[ecuIdx][3]);
    Diag_WriteMaskFilterCn(udsRxBuf[ecuIdx][3]);
    off = 4;
  }
  else
    off = 3;

  payloadLen = udsRxLen[ecuIdx] - off;
  if (payloadLen <= 0)
  {
    write("  (后续无故障记录，仅返回包头)");
    write("  --- 中文释义结束 ---");
    return;
  }

  if (payloadLen % 5 == 0)
    recordSize = 5;
  else if (payloadLen % 4 == 0)
    recordSize = 4;
  else
    recordSize = 4;

  write("  --- 故障记录区 (每条 %d 字节) ---", recordSize);
  idx = 0;
  while (off + recordSize - 1 < udsRxLen[ecuIdx])
  {
    dtcB0 = udsRxBuf[ecuIdx][off];
    dtcB1 = udsRxBuf[ecuIdx][off + 1];
    dtcB2 = udsRxBuf[ecuIdx][off + 2];
    if (recordSize == 5)
    {
      failType = udsRxBuf[ecuIdx][off + 3];
      status = udsRxBuf[ecuIdx][off + 4];
      write(
        "  [%02X %02X %02X %02X %02X] 故障记录#%d",
        dtcB0, dtcB1, dtcB2, failType, status, idx + 1
      );
    }
    else
    {
      failType = dtcB2 & 0x0F;
      status = udsRxBuf[ecuIdx][off + 3];
      write(
        "  [%02X %02X %02X %02X] 故障记录#%d",
        dtcB0, dtcB1, dtcB2, status, idx + 1
      );
    }

    Diag_FormatDtcCode(dtcB0, dtcB1, dtcB2, dtcStr, elCount(dtcStr));
    Diag_FormatDtcDomainCn(dtcB0, domainCn, elCount(domainCn));
    write(
      "      故障码: %s (%s, 原始三字节 0x%02X%02X%02X)",
      dtcStr, domainCn, dtcB0, dtcB1, dtcB2
    );
    write("      说明: 具体故障现象请对照主机厂DTC定义表");
    if (recordSize == 5)
      write("      故障类型字节: 0x%02X", failType);
    write("      状态字节: 0x%02X", status);
    Diag_WriteDtcStatusCn(status);
    off += recordSize;
    idx++;
  }

  if (idx == 0)
    write("  (未解析出完整故障记录)");
  else
    write("  共解读 %d 条故障记录", idx);

  write("  --- 中文释义结束 ---");
}

void Diag_SendTpSingle_19_02_09(long ecuIdx)
{
  switch (ecuIdx)
  {
    case 0:
      msg_ADC_0x712.CAN = DIAG_CAN_CH;
      msg_ADC_0x712.byte(0) = 0x03;
      msg_ADC_0x712.byte(1) = 0x19;
      msg_ADC_0x712.byte(2) = 0x02;
      msg_ADC_0x712.byte(3) = DTC_STATUS_MASK;
      msg_ADC_0x712.byte(4) = 0x00;
      msg_ADC_0x712.byte(5) = 0x00;
      msg_ADC_0x712.byte(6) = 0x00;
      msg_ADC_0x712.byte(7) = 0x00;
      output(msg_ADC_0x712);
      break;
    case 1:
      msg_LFCR_0x760.CAN = DIAG_CAN_CH;
      msg_LFCR_0x760.byte(0) = 0x03;
      msg_LFCR_0x760.byte(1) = 0x19;
      msg_LFCR_0x760.byte(2) = 0x02;
      msg_LFCR_0x760.byte(3) = DTC_STATUS_MASK;
      msg_LFCR_0x760.byte(4) = 0x00;
      msg_LFCR_0x760.byte(5) = 0x00;
      msg_LFCR_0x760.byte(6) = 0x00;
      msg_LFCR_0x760.byte(7) = 0x00;
      output(msg_LFCR_0x760);
      break;
    case 2:
      msg_Lidar_0x736.CAN = DIAG_CAN_CH;
      msg_Lidar_0x736.byte(0) = 0x03;
      msg_Lidar_0x736.byte(1) = 0x19;
