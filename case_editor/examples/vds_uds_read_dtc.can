      msg_LRCR_0x7D4.byte(1) = 0x00;
      msg_LRCR_0x7D4.byte(2) = 0x00;
      msg_LRCR_0x7D4.byte(3) = 0x00;
      msg_LRCR_0x7D4.byte(4) = 0x00;
      msg_LRCR_0x7D4.byte(5) = 0x00;
      msg_LRCR_0x7D4.byte(6) = 0x00;
      msg_LRCR_0x7D4.byte(7) = 0x00;
      output(msg_LRCR_0x7D4);
      break;
    case 6:
      msg_MRR_0x7F2.CAN = DIAG_CAN_CH;
      msg_MRR_0x7F2.byte(0) = 0x30;
      msg_MRR_0x7F2.byte(1) = 0x00;
      msg_MRR_0x7F2.byte(2) = 0x00;
      msg_MRR_0x7F2.byte(3) = 0x00;
      msg_MRR_0x7F2.byte(4) = 0x00;
      msg_MRR_0x7F2.byte(5) = 0x00;
      msg_MRR_0x7F2.byte(6) = 0x00;
      msg_MRR_0x7F2.byte(7) = 0x00;
      output(msg_MRR_0x7F2);
      break;
    case 7:
      msg_PAS_0x701.CAN = DIAG_CAN_CH;
      msg_PAS_0x701.byte(0) = 0x30;
      msg_PAS_0x701.byte(1) = 0x00;
      msg_PAS_0x701.byte(2) = 0x00;
      msg_PAS_0x701.byte(3) = 0x00;
      msg_PAS_0x701.byte(4) = 0x00;
      msg_PAS_0x701.byte(5) = 0x00;
      msg_PAS_0x701.byte(6) = 0x00;
      msg_PAS_0x701.byte(7) = 0x00;
      output(msg_PAS_0x701);
      break;
    case 8:
      msg_RFCR_0x761.CAN = DIAG_CAN_CH;
      msg_RFCR_0x761.byte(0) = 0x30;
      msg_RFCR_0x761.byte(1) = 0x00;
      msg_RFCR_0x761.byte(2) = 0x00;
      msg_RFCR_0x761.byte(3) = 0x00;
      msg_RFCR_0x761.byte(4) = 0x00;
      msg_RFCR_0x761.byte(5) = 0x00;
      msg_RFCR_0x761.byte(6) = 0x00;
      msg_RFCR_0x761.byte(7) = 0x00;
      output(msg_RFCR_0x761);
      break;
    case 9:
      msg_RRCR_0x7C2.CAN = DIAG_CAN_CH;
      msg_RRCR_0x7C2.byte(0) = 0x30;
      msg_RRCR_0x7C2.byte(1) = 0x00;
      msg_RRCR_0x7C2.byte(2) = 0x00;
      msg_RRCR_0x7C2.byte(3) = 0x00;
      msg_RRCR_0x7C2.byte(4) = 0x00;
      msg_RRCR_0x7C2.byte(5) = 0x00;
      msg_RRCR_0x7C2.byte(6) = 0x00;
      msg_RRCR_0x7C2.byte(7) = 0x00;
      output(msg_RRCR_0x7C2);
      break;
  }
}

void Diag_SendReadDtcOnEcu(long ecuIdx)
{
  write("[VDS-Diag] 发送 ");
  Diag_WriteEcuLabel(ecuIdx);
  write(" 19 02 %02X", DTC_STATUS_MASK);
  Diag_SendTpSingle_19_02_09(ecuIdx);
}

void Diag_SendFunctional(void)
{
  long i;
  write("[VDS-Diag] 发送 功能寻址7DF 19 02 %02X", DTC_STATUS_MASK);
  for (i = 0; i < DIAG_ECU_COUNT; i++)
    Diag_ResetTpRx(i);
  msg_VDS_0x7DF.CAN = DIAG_CAN_CH;
  msg_VDS_0x7DF.byte(0) = 0x03;
  msg_VDS_0x7DF.byte(1) = 0x19;
  msg_VDS_0x7DF.byte(2) = 0x02;
  msg_VDS_0x7DF.byte(3) = DTC_STATUS_MASK;
  msg_VDS_0x7DF.byte(4) = 0x00;
  msg_VDS_0x7DF.byte(5) = 0x00;
  msg_VDS_0x7DF.byte(6) = 0x00;
  msg_VDS_0x7DF.byte(7) = 0x00;
  output(msg_VDS_0x7DF);
}

void Diag_DescribeStatusFull(byte st, char out[], long outSize)
{
  snprintf(
    out, outSize,
    "bit0:测试失败=%d bit1:本周期测试失败=%d bit2:待确认=%d bit3:已确认=%d "
    "bit4:自清除后未完成=%d bit5:自清除后仍失败=%d bit6:MIL灯=%d bit7=%d 原始=0x%02X",
    (st & 0x01) != 0,
    (st & 0x02) != 0,
    (st & 0x04) != 0,
    (st & 0x08) != 0,
    (st & 0x10) != 0,
    (st & 0x20) != 0,
    (st & 0x40) != 0,
    (st & 0x80) != 0,
    st
  );
}

void Diag_DescribeAvailMask(byte mask)
{
  write(
    "    可用掩码: 测试失败=%d 本周期失败=%d 待确认=%d 已确认=%d 自清除后未完成=%d 自清除后失败=%d MIL=%d 保留=%d 原始=0x%02X",
    (mask & 0x01) != 0,
    (mask & 0x02) != 0,
    (mask & 0x04) != 0,
    (mask & 0x08) != 0,
    (mask & 0x10) != 0,
    (mask & 0x20) != 0,
    (mask & 0x40) != 0,
    (mask & 0x80) != 0,
    mask
  );
}

void Diag_PrintFullUdsHex(long ecuIdx)
{
  long i;
  long lineStart;
  write("  --- UDS完整载荷 (%d 字节) ---", udsRxLen[ecuIdx]);
  lineStart = 0;
  while (lineStart < udsRxLen[ecuIdx])
  {
    write(
      "  %04X: %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X",
      lineStart,
      lineStart + 0 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 0] : 0,
      lineStart + 1 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 1] : 0,
      lineStart + 2 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 2] : 0,
      lineStart + 3 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 3] : 0,
      lineStart + 4 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 4] : 0,
      lineStart + 5 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 5] : 0,
      lineStart + 6 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 6] : 0,
      lineStart + 7 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 7] : 0,
      lineStart + 8 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 8] : 0,
      lineStart + 9 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 9] : 0,
      lineStart + 10 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 10] : 0,
      lineStart + 11 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 11] : 0,
      lineStart + 12 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 12] : 0,
      lineStart + 13 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 13] : 0,
      lineStart + 14 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 14] : 0,
      lineStart + 15 < udsRxLen[ecuIdx] ? udsRxBuf[ecuIdx][lineStart + 15] : 0
    );
    lineStart += 16;
  }
  write("  --- UDS载荷结束 ---");
}

void Diag_SetLastRxMeta(long ecuIdx, long rxId)
{
  diagLastRxId = rxId;
  diagLastDtcCount = 0;
}

void Diag_ParseNegativeFull(long ecuIdx)
{
  char nrcDesc[48];
  write("[VDS-Diag] ===== 否定响应 =====");
  Diag_PrintFullUdsHex(ecuIdx);
  write("  --- 否定响应中文释义 ---");
  if (udsRxLen[ecuIdx] >= 1 && udsRxBuf[ecuIdx][0] == 0x7F)
    write("  [7F] 这是一条UDS否定响应，请求未被执行");
  if (udsRxLen[ecuIdx] >= 2)
    write("  [%02X] 被拒绝的请求服务ID", udsRxBuf[ecuIdx][1]);
  if (udsRxLen[ecuIdx] >= 3)
  {
    Diag_DescribeNrc(udsRxBuf[ecuIdx][2], nrcDesc, elCount(nrcDesc));
    write("  [%02X] 否定原因: %s", udsRxBuf[ecuIdx][2], nrcDesc);
  }
  write("  --- 否定响应中文释义结束 ---");
  if (udsRxLen[ecuIdx] >= 1)
    write("  [0] 否定响应SID     = 0x%02X", udsRxBuf[ecuIdx][0]);
  if (udsRxLen[ecuIdx] >= 2)
    write("  [1] 被请求SID       = 0x%02X", udsRxBuf[ecuIdx][1]);
  if (udsRxLen[ecuIdx] >= 3)
  {
    Diag_DescribeNrc(udsRxBuf[ecuIdx][2], nrcDesc, elCount(nrcDesc));
    write("  [2] NRC否定码       = 0x%02X (%s)", udsRxBuf[ecuIdx][2], nrcDesc);
  }
  write("[VDS-Diag] ===== 否定响应结束 =====");
}

void Diag_ParseDtcRecords(long ecuIdx, long off, long recordSize)
{
  long dtcCount;
  byte dtcB0, dtcB1, dtcB2, failType, status;
  char dtcStr[16];
  char stStr[160];

  dtcCount = 0;
  while (off + recordSize - 1 < udsRxLen[ecuIdx])
  {
    dtcB0 = udsRxBuf[ecuIdx][off];
    dtcB1 = udsRxBuf[ecuIdx][off + 1];
    dtcB2 = udsRxBuf[ecuIdx][off + 2];
    if (recordSize == 5)
    {
      failType = udsRxBuf[ecuIdx][off + 3];
      status = udsRxBuf[ecuIdx][off + 4];
    }
    else
    {
      failType = dtcB2 & 0x0F;
      status = udsRxBuf[ecuIdx][off + 3];
    }
    off += recordSize;

    Diag_FormatDtcCode(dtcB0, dtcB1, dtcB2, dtcStr, elCount(dtcStr));
    Diag_DescribeStatusFull(status, stStr, elCount(stStr));
    write(
      "  DTC#%d 故障码=%s 原始DTC=0x%02X%02X%02X 故障类型=0x%02X",
      dtcCount + 1, dtcStr, dtcB0, dtcB1, dtcB2, failType
    );
    write("         状态: %s", stStr);
    dtcCount++;
  }

  diagLastDtcCount = dtcCount;
  if (off < udsRxLen[ecuIdx])
  {
    write("  尾部剩余字节 (%d):", udsRxLen[ecuIdx] - off);
    while (off < udsRxLen[ecuIdx])
    {
      write("    [%d] = 0x%02X", off, udsRxBuf[ecuIdx][off]);
      off++;
    }
  }
  if (dtcCount == 0)
    write("  (载荷中无DTC记录)");
  else
    write("  DTC记录总数: %d", dtcCount);
}

void Diag_ParsePositiveReadDtcFull(long ecuIdx)
{
  long off;
  long payloadLen;
  long recordSize;
  byte availMask;

  write("[VDS-Diag] ===== 读DTC正响应完整解析 =====");
  Diag_PrintFullUdsHex(ecuIdx);
  Diag_PrintReadDtcChineseExplain(ecuIdx);

  if (udsRxLen[ecuIdx] < 3)
  {
    write("  载荷过短，无法解析读DTC");
    write("[VDS-Diag] ===== 解析结束 =====");
    return;
  }

  write("  [0] 正响应SID         = 0x%02X (读DTC信息服务+0x40)", udsRxBuf[ecuIdx][0]);
  write("  [1] 报告类型          = 0x%02X (按状态掩码报告DTC)", udsRxBuf[ecuIdx][1]);
  write("  [2] 状态掩码回显      = 0x%02X", udsRxBuf[ecuIdx][2]);

  if (udsRxLen[ecuIdx] >= 4)
  {
    availMask = udsRxBuf[ecuIdx][3];
    write("  [3] DTC状态可用性掩码 = 0x%02X", availMask);
    Diag_DescribeAvailMask(availMask);
    off = 4;
  }
  else
  {
    off = 3;
    write("  (无可用性掩码字节)");
  }

  payloadLen = udsRxLen[ecuIdx] - off;
  write("  DTC数据区: 偏移=%d 长度=%d 字节", off, payloadLen);

  if (payloadLen <= 0)
  {
    write("  (包头后无DTC数据)");
    diagLastDtcCount = 0;
    write("[VDS-Diag] ===== 解析结束 =====");
    return;
  }

  /* 自动判断 4 字节/条(DTC3+status) 或 5 字节/条(DTC3+FT+status) */
  if (payloadLen % 5 == 0)
    recordSize = 5;
  else if (payloadLen % 4 == 0)
    recordSize = 4;
  else
  {
    recordSize = 4;
    write("  警告: 载荷与4/5字节DTC记录不对齐，按4字节解析");
  }

  if (recordSize == 5)
    write("  记录格式: 每条5字节 (3字节DTC + 1字节故障类型 + 1字节状态)");
  else
    write("  记录格式: 每条4字节 (3字节DTC + 1字节状态)");
  Diag_ParseDtcRecords(ecuIdx, off, recordSize);
  write("[VDS-Diag] ===== 完整解析结束 =====");
}

void Diag_ParseFullResult(long ecuIdx, long rxId)
{
  Diag_SetLastRxMeta(ecuIdx, rxId);
  write("[VDS-Diag] ===== ");
  Diag_WriteEcuLabel(ecuIdx);
  write(" 接收 ID=0x%X UDS长度=%d =====", rxId, udsRxLen[ecuIdx]);

  if (udsRxLen[ecuIdx] < 1)
  {
    write("  UDS载荷为空");
    return;
  }

  if (udsRxBuf[ecuIdx][0] == 0x7F)
  {
    Diag_ParseNegativeFull(ecuIdx);
    return;
  }

  if (udsRxBuf[ecuIdx][0] == 0x59 && udsRxLen[ecuIdx] >= 2 && udsRxBuf[ecuIdx][1] == 0x02)
  {
    Diag_ParsePositiveReadDtcFull(ecuIdx);
    return;
  }

  /* 其它正响应：仍打印完整十六进制并按字节标注 */
  write("[VDS-Diag] ===== 其它正响应/未知服务 =====");
  Diag_PrintFullUdsHex(ecuIdx);
  write("  [0] 服务SID = 0x%02X", udsRxBuf[ecuIdx][0]);
  write("[VDS-Diag] ===== 解析结束 =====");
}

void Diag_ParseUdsPayload(long ecuIdx, long rxId)
{
  Diag_ParseFullResult(ecuIdx, rxId);
}

void Diag_OnTpComplete(long ecuIdx, long rxId)
{
  Diag_ParseUdsPayload(ecuIdx, rxId);
  Diag_ResetTpRx(ecuIdx);
}

void Diag_OnRxMessage(long ecuIdx, long rxId)
{
  byte pci;
  long sfLen;
  long totalLen;
  long i;
  long copyLen;
  byte seq;

  pci = diagRxData[0];

  if ((pci & 0xF0) == 0x00)
  {
    sfLen = pci & 0x0F;
    if (sfLen < 1)
      return;
    Diag_ResetTpRx(ecuIdx);
    for (i = 0; i < sfLen && i < 7; i++)
      udsRxBuf[ecuIdx][i] = diagRxData[1 + i];
    udsRxLen[ecuIdx] = sfLen;
    udsRxIdx[ecuIdx] = sfLen;
    Diag_OnTpComplete(ecuIdx, rxId);
    return;
  }

  if ((pci & 0xF0) == 0x10)
  {
    totalLen = ((pci & 0x0F) << 8) | (diagRxData[1] & 0xFF);
    if (totalLen <= 0 || totalLen > UDS_BUF_SIZE)
      return;
    Diag_ResetTpRx(ecuIdx);
    udsRxLen[ecuIdx] = totalLen;
    tpRxActive[ecuIdx] = 1;
    tpExpectSeq[ecuIdx] = 1;
    copyLen = 6;
    if (copyLen > totalLen)
      copyLen = totalLen;
    for (i = 0; i < copyLen; i++)
      udsRxBuf[ecuIdx][i] = diagRxData[2 + i];
    udsRxIdx[ecuIdx] = copyLen;
    Diag_SendFlowControlForEcu(ecuIdx);
    return;
  }

  if ((pci & 0xF0) == 0x20 && tpRxActive[ecuIdx])
  {
    seq = pci & 0x0F;
    if (seq != tpExpectSeq[ecuIdx])
    {
      write("[VDS-Diag] 连续帧序号错误 ecu=%d", ecuIdx);
      Diag_ResetTpRx(ecuIdx);
      return;
    }
    tpExpectSeq[ecuIdx] = (tpExpectSeq[ecuIdx] + 1) & 0x0F;
    if (tpExpectSeq[ecuIdx] == 0)
      tpExpectSeq[ecuIdx] = 1;
    copyLen = 7;
    if (udsRxIdx[ecuIdx] + copyLen > udsRxLen[ecuIdx])
      copyLen = udsRxLen[ecuIdx] - udsRxIdx[ecuIdx];
    for (i = 0; i < copyLen; i++)
      udsRxBuf[ecuIdx][udsRxIdx[ecuIdx] + i] = diagRxData[1 + i];
    udsRxIdx[ecuIdx] += copyLen;
    if (udsRxIdx[ecuIdx] >= udsRxLen[ecuIdx])
      Diag_OnTpComplete(ecuIdx, rxId);
  }
}

void Diag_SendToEcuIndex(long ecuIdx)
{
  if (ecuIdx < 0 || ecuIdx >= DIAG_ECU_COUNT)
    return;
  Diag_ResetTpRx(ecuIdx);
  Diag_SendReadDtcOnEcu(ecuIdx);
}

void Diag_StartRequest(long target)
{
  if (target == DIAG_FUNC_TARGET)
  {
    Diag_SendFunctional();
    return;
  }
  if (target == DIAG_ALL_TARGET)
  {
    diagPollIdx = 0;
    diagPollActive = 1;
    Diag_SendToEcuIndex(0);
    setTimer(tmr_diag_poll, 150);
    return;
  }
  if (target >= 0 && target < DIAG_ECU_COUNT)
  {
    Diag_SendToEcuIndex(target);
    return;
  }
  write("[VDS-Diag] diagnosticTarget=%d 无效 (0~9, 10, 255)", target);
}

on start
{
  Diag_ResetAllTpRx();
  diagPollIdx = 0;
  diagPollActive = 0;
  write("[VDS-Diag] 就绪。target: 0=ADC..9=RRCR, 10=7DF功能寻址, 255=轮询全部");
}

on sysvar sysvar::diagnosticButton
{
  long target;
  if (@sysvar::diagnosticButton != 1)
    return;
  if (@sysvar::diagnosticTarget < 0)
    target = 0;
  else
    target = @sysvar::diagnosticTarget;
  Diag_StartRequest(target);
  @sysvar::diagnosticButton = 0;
}

on timer tmr_diag_poll
{
  if (!diagPollActive)
    return;
  diagPollIdx++;
  if (diagPollIdx >= DIAG_ECU_COUNT)
  {
    diagPollActive = 0;
    write("[VDS-Diag] 全部ECU轮询完成");
    return;
  }
  Diag_SendToEcuIndex(diagPollIdx);
  setTimer(tmr_diag_poll, 150);
}

/* 仅处理 VDS 接收诊断 ID */
on message *
{
  long ecuIdx;
  long i;
  if (this.CAN != DIAG_CAN_CH)
    return;
  ecuIdx = Diag_RxIdToEcuIdx(this.id);
  if (ecuIdx < 0)
    return;
  for (i = 0; i < 8; i++)
    diagRxData[i] = this.byte(i);
  Diag_OnRxMessage(ecuIdx, this.id);
}
